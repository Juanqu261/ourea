# Copy to `.env` at the repository root. Git ignores `.env`.
# Never prefix the OpenAI key with VITE_. The frontend only needs the public API URL.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ALLOWED_ORIGINS=https://ybedoyab.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Base URL of the local decision AI service. Empty → the app renders no service UI (GitHub Pages).
VITE_OUREA_AI_API_URL=http://127.0.0.1:8787/api
# The agents (/api/agents/*) need this and a key. Tools and /api/audit work without either.
OUREA_AI_ENABLED=0
# Supuesto: an interview gap is asked while its switching ratio is at most this.
OUREA_FLIP_THRESHOLD=2.0
# Set to none for models that reject a temperature parameter.
OUREA_MODEL_TEMPERATURE=0
# Optional tracing. Off by default; never with real interview data.
LANGSMITH_TRACING=false
