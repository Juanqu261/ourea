{
  "schema": "ourea-nanjing-landcover-assumptions",
  "schema_version": 1,
  "label": "land-cover-derived screening proxy assumptions",
  "not": [
    "measured imperviousness",
    "calibrated runoff coefficients",
    "hydraulic parameters"
  ],
  "source_product": "ESA WorldCover 2021 v200 class codes",
  "composite_runoff_formula": "cell_runoff_pressure = mean(class.runoff_weight over WorldCover pixels in cell)",
  "classes": {
    "10": { "name": "tree_cover", "built": 0.0, "veg": 1.0, "water": 0.0, "runoff_weight": 0.15 },
    "20": { "name": "shrubland", "built": 0.0, "veg": 0.85, "water": 0.0, "runoff_weight": 0.2 },
    "30": { "name": "grassland", "built": 0.0, "veg": 0.7, "water": 0.0, "runoff_weight": 0.25 },
    "40": { "name": "cropland", "built": 0.05, "veg": 0.4, "water": 0.0, "runoff_weight": 0.35 },
    "50": { "name": "built_up", "built": 1.0, "veg": 0.0, "water": 0.0, "runoff_weight": 0.85 },
    "60": { "name": "bare_sparse", "built": 0.1, "veg": 0.05, "water": 0.0, "runoff_weight": 0.55 },
    "70": { "name": "snow_ice", "built": 0.0, "veg": 0.0, "water": 0.0, "runoff_weight": 0.1 },
    "80": { "name": "permanent_water", "built": 0.0, "veg": 0.0, "water": 1.0, "runoff_weight": 0.05 },
    "90": { "name": "herbaceous_wetland", "built": 0.0, "veg": 0.6, "water": 0.3, "runoff_weight": 0.2 },
    "95": { "name": "mangroves", "built": 0.0, "veg": 0.5, "water": 0.2, "runoff_weight": 0.2 },
    "100": { "name": "moss_lichen", "built": 0.0, "veg": 0.15, "water": 0.0, "runoff_weight": 0.4 }
  }
}
